# Settings of the Klass8 API. Nothing here is secret.
#
# Secrets live only in /opt/klass8-api/.env on the server (chmod 600), never in
# the repo:
#   JWT_SECRET             required, 64+ random characters
#   ADMIN_TOKEN            operator endpoints (voucher creation), 32+ characters
#   GROQ_API_KEY           AI tutor and marking (primary provider)
#   ANTHROPIC_API_KEY      optional alternative, used when AI_PROVIDER=anthropic
#   KOKORO_VOICE_KEY       the key shared with the voice server (VOICE_KEY in /opt/klass8-voice/.env)
#   FAPSHI_API_USER / FAPSHI_API_KEY / FAPSHI_WEBHOOK_SECRET   payments (set FAPSHI_ENV=live for real money)
#   Messaging, any of (tried in this order):
#     WHATSAPP_TOKEN / WHATSAPP_PHONE_ID (+ WHATSAPP_CODE_TEMPLATE, WHATSAPP_CONSENT_TEMPLATE, WHATSAPP_ALERT_TEMPLATE)
#     ORANGE_CLIENT_ID / ORANGE_CLIENT_SECRET / ORANGE_SENDER (+ ORANGE_SENDER_NAME)
#     AT_USERNAME / AT_API_KEY (+ AT_SENDER_ID)       Africa's Talking
#     TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM
#   SUPPORT_EMAIL          shown on the parent consent page

FAPSHI_ENV=sandbox
# Browser origins allowed to call the API (the local web preview).
ALLOWED_ORIGINS=http://localhost:8081
# The address the app reaches the API at, used in links to the 3D models.
PUBLIC_API_URL=https://klass8.ebenesaid.com
# The tutor's voice: Kokoro-82M on this server (worker/voice), British male for
# English and a French voice for French. KOKORO_VOICE names them, so phones
# notice when they change.
VOICE_ENGINE=kokoro
KOKORO_URL=http://klass8-voice:8880
KOKORO_VOICE=bm_fable+ff_siwis@0.92
# Characters of new speech per day across all users (clips already made are free).
VOICE_DAILY_CHARS=400000
