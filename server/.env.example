# Required — your real Anthropic API key. Lives only here, on the server.
# Students/the frontend never see this.
ANTHROPIC_API_KEY=sk-ant-...

# Which model to call. See product docs for current model IDs.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — set this to give your class a shared passcode so random
# internet strangers can't use your API quota. Leave blank to disable
# (fine for local-only testing, not recommended once deployed publicly).
APP_PASSCODE=

# Comma-separated list of origins allowed to call this server, e.g.
# https://your-school-site.pages.dev,http://localhost:5173
# Use * only for local development.
ALLOWED_ORIGINS=http://localhost:5173

# How many /api/ask requests a single IP may make per hour.
MAX_REQUESTS_PER_HOUR=30

PORT=8787
