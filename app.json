{
  "expo": {
    "name": "BioSpatial VR",
    "slug": "biospatial-vr",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/img/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biospatial.vr"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-foreground.png",
        "backgroundColor": "#0369a1"
      },
      "package": "com.biospatial.vr",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/img/app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f7f9fb"
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
