{
  "expo": {
    "name": "SciAid",
    "slug": "sciaid",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/img/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sciaid.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SciAid uses the camera to photograph your handwritten answers for marking.",
        "NSPhotoLibraryUsageDescription": "SciAid lets you choose a photo of your handwritten answer for marking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-foreground.png",
        "backgroundColor": "#0369a1"
      },
      "package": "com.sciaid.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/img/app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SciAid uses the camera to photograph your handwritten answers for marking.",
          "photosPermission": "SciAid lets you choose a photo of your handwritten answer for marking.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0369a1"
        }
      ]
    ]
  }
}