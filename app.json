{
  "expo": {
    "name": "Klass8",
    "slug": "sciaid",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/img/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sciaid.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Klass8 uses the camera to photograph your handwritten answers for marking.",
        "NSPhotoLibraryUsageDescription": "Klass8 lets you choose a photo of your handwritten answer for marking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-foreground.png",
        "monochromeImage": "./assets/img/adaptive-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sciaid.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/img/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Klass8 uses the camera to photograph your handwritten answers for marking.",
          "photosPermission": "Klass8 lets you choose a photo of your handwritten answer for marking.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#02287B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Klass8 uses the microphone only when you tap it, so you can ask the AI questions by voice. Recordings are not kept.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
